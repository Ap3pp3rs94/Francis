{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://francis.local/schemas/grounded_presence_delivery_attempt.schema.json",
  "title": "Francis Grounded Presence Delivery Attempt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "schema_path",
    "attempt_id",
    "recorded_at",
    "delivery",
    "reconciliation",
    "authority"
  ],
  "properties": {
    "kind": {
      "const": "francis.grounded_presence.delivery_attempt"
    },
    "schema_version": {
      "const": "francis.grounded_presence.delivery_attempt.v1"
    },
    "schema_path": {
      "const": "schemas/grounded_presence_delivery_attempt.schema.json"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^gpt_[0-9a-f]{32}$"
    },
    "recorded_at": {
      "$ref": "#/$defs/timestamp"
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "envelope_id",
        "adapter_id",
        "session_id",
        "sequence",
        "endpoint_id",
        "payload_digest",
        "message_id",
        "authentication_key_id"
      ],
      "properties": {
        "state": {
          "const": "delivery_attempt_pending"
        },
        "envelope_id": {
          "type": "string",
          "pattern": "^gpe_[0-9a-f]{32}$"
        },
        "adapter_id": {
          "$ref": "#/$defs/contract_id"
        },
        "session_id": {
          "$ref": "#/$defs/contract_id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "endpoint_id": {
          "$ref": "#/$defs/contract_id"
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "message_id": {
          "type": "string",
          "pattern": "^gpm_[0-9a-f]{32}$"
        },
        "authentication_key_id": {
          "$ref": "#/$defs/contract_id"
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_persisted",
        "delivery_acknowledged",
        "receipt_written",
        "exact_envelope_required",
        "fresh_authenticated_wrapper_required",
        "consumer_durable_deduplication_required"
      ],
      "properties": {
        "payload_persisted": {
          "const": false
        },
        "delivery_acknowledged": {
          "const": false
        },
        "receipt_written": {
          "const": false
        },
        "exact_envelope_required": {
          "const": true
        },
        "fresh_authenticated_wrapper_required": {
          "const": true
        },
        "consumer_durable_deduplication_required": {
          "const": true
        }
      }
    },
    "authority": {
      "$ref": "#/$defs/authority"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "francis_core_authoritative",
        "grants_execution_authority",
        "grants_desktop_authority",
        "grants_network_authority",
        "grants_memory_write_authority",
        "grants_approval_authority"
      ],
      "properties": {
        "francis_core_authoritative": {
          "const": true
        },
        "grants_execution_authority": {
          "const": false
        },
        "grants_desktop_authority": {
          "const": false
        },
        "grants_network_authority": {
          "const": false
        },
        "grants_memory_write_authority": {
          "const": false
        },
        "grants_approval_authority": {
          "const": false
        }
      }
    }
  }
}
