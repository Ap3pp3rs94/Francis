  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_reference": {
      "type": "object",
      "required": ["kind", "id", "source", "correlation_status"],
      "properties": {
        "kind": {
          "enum": ["receipt", "approval", "trace", "run", "artifact"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "correlation_status": {
          "const": "correlated"
