        }
      },
      "additionalProperties": false
    },
    "freshness_source": {
      "type": "object",
      "required": ["available", "status", "observed_at", "age_seconds", "stale", "reason"],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "status": {
          "enum": ["observed", "stale", "missing_evidence", "invalid"]
        },
        "observed_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "age_seconds": {
          "type": ["number", "null"]
        },
        "stale": {
          "type": ["boolean", "null"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "observed"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "observed_at": {
                "$ref": "#/$defs/timestamp"
              },
              "age_seconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 300
              },
              "stale": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "stale"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "observed_at": {
                "$ref": "#/$defs/timestamp"
              },
              "age_seconds": {
                "type": "number",
                "exclusiveMinimum": 300
              },
              "stale": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "missing_evidence"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "observed_at": {
                "type": "null"
              },
              "age_seconds": {
                "type": "null"
              },
              "stale": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "invalid"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "observed_at": {
                "$ref": "#/$defs/timestamp"
              },
              "age_seconds": {
                "type": "number",
                "exclusiveMaximum": 0
              },
              "stale": {
                "type": "null"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
