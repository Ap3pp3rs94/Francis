          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "ready": {
                "type": "null"
              },
              "source": {
                "const": ""
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "observed"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "ready": {
                "type": "boolean"
              },
              "source": {
                "minLength": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
