{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://francis.local/schemas/plugins.schema.json",
  "title": "Francis Plugin Descriptor",
  "type": "object",
  "required": ["id", "name", "status"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["enabled", "disabled", "error", "installing", "uninstalling", "updating", "unknown", "uninstalled"]
    },
    "enabled": {
      "type": "boolean"
    },
    "source_kind": {
      "type": "string"
    },
    "source_ref": {
      "type": "string"
    },
    "risk_tier": {
      "type": "string",
      "enum": ["readonly", "low", "normal", "medium", "high", "critical", "safety_critical"]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "action"],
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "meta": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
