{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://francis.local/schemas/grounded_presence_delivery_journal.schema.json",
  "title": "Francis Grounded Presence Delivery Journal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "schema_path",
    "journal_id",
    "recorded_at",
    "delivery",
    "persistence",
    "authority"
  ],
  "properties": {
    "kind": {
      "const": "francis.grounded_presence.delivery_journal"
    },
    "schema_version": {
      "const": "francis.grounded_presence.delivery_journal.v1"
    },
    "schema_path": {
      "const": "schemas/grounded_presence_delivery_journal.schema.json"
    },
    "journal_id": {
      "type": "string",
      "pattern": "^gpp_[0-9a-f]{32}$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "envelope_id",
        "adapter_id",
        "session_id",
        "sequence",
        "endpoint_id",
        "bytes_written",
        "payload_digest",
        "message_id",
        "ack_id",
        "consumer_status",
        "authentication_key_id"
      ],
      "properties": {
        "state": {
          "const": "delivered_receipt_pending"
        },
        "envelope_id": {
          "type": "string",
          "pattern": "^gpe_[0-9a-f]{32}$"
        },
        "adapter_id": {
          "$ref": "#/$defs/contract_id"
        },
        "session_id": {
          "$ref": "#/$defs/contract_id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "endpoint_id": {
          "$ref": "#/$defs/contract_id"
        },
        "bytes_written": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262148
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "message_id": {
          "type": "string",
          "pattern": "^gpm_[0-9a-f]{32}$"
        },
        "ack_id": {
          "type": "string",
          "pattern": "^gpa_[0-9a-f]{32}$"
        },
        "consumer_status": {
          "enum": ["accepted_for_render", "duplicate_already_accepted"]
        },
        "authentication_key_id": {
          "$ref": "#/$defs/contract_id"
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_persisted",
        "receipt_pending",
        "safe_redelivery",
        "exact_envelope_retry_repairs_receipt",
        "consumer_durable_deduplication",
        "acknowledgement_authenticated"
      ],
      "properties": {
        "payload_persisted": {
          "const": false
        },
        "receipt_pending": {
          "const": true
        },
        "safe_redelivery": {
          "const": true
        },
        "exact_envelope_retry_repairs_receipt": {
          "const": true
        },
        "consumer_durable_deduplication": {
          "const": true
        },
        "acknowledgement_authenticated": {
          "const": true
        }
      }
    },
    "authority": {
      "$ref": "#/$defs/authority"
    }
  },
  "$defs": {
    "contract_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "francis_core_authoritative",
        "grants_execution_authority",
        "grants_desktop_authority",
        "grants_network_authority",
        "grants_memory_write_authority",
        "grants_approval_authority"
      ],
      "properties": {
        "francis_core_authoritative": {
          "const": true
        },
        "grants_execution_authority": {
          "const": false
        },
        "grants_desktop_authority": {
          "const": false
        },
        "grants_network_authority": {
          "const": false
        },
        "grants_memory_write_authority": {
          "const": false
        },
        "grants_approval_authority": {
          "const": false
        }
      }
    }
  }
}
