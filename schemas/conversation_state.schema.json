{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://francis.local/schemas/conversation_state.schema.json",
  "title": "Francis Conversation State",
  "type": "object",
  "required": ["conversation_id", "messages", "updated_at"],
  "properties": {
    "conversation_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "updated_at": {
      "type": "number"
    },
    "summary": {
      "type": "string"
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "./chat_message.schema.json"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
