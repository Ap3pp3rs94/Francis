{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://francis.local/schemas/risk_assessment.schema.json",
  "title": "Francis Risk Assessment",
  "type": "object",
  "required": ["action", "risk_tier", "allowed", "required_trust"],
  "properties": {
    "action": {
      "type": "string",
      "minLength": 1
    },
    "risk_tier": {
      "type": "string",
      "enum": ["readonly", "low", "normal", "medium", "high", "critical", "safety_critical"]
    },
    "allowed": {
      "type": "boolean"
    },
    "approvals_required": {
      "type": "boolean"
    },
    "required_trust": {
      "type": "integer"
    },
    "current_trust": {
      "type": "integer"
    },
    "confidence": {
      "type": "string",
      "enum": ["confirmed", "likely", "uncertain"]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
