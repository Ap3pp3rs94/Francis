# ==============================================================================
# FRANCIS — .env.example
# Cone Layer 0: Foundation Runtime Configuration Template
# ==============================================================================
# This file is a TEMPLATE. Do not run directly from it.
#
# Usage:
#   1) Copy this file to ".env" at the repo root
#   2) Edit only what you need
#   3) Keep ".env" out of source control
#
# Dotenv compatibility rules (IMPORTANT):
#   - Do NOT put inline comments on KEY=value lines.
#     Some dotenv parsers treat " # comment" as part of the value.
#   - Treat all values as strings; parse bool/int/float in code.
#   - Use true/false (lowercase) for booleans to avoid parser ambiguity.
#   - Prefer relative paths (./data) for portability.
#   - Windows absolute paths: prefer forward slashes (C:/Francis/data) or escape
#     backslashes (C:\\Francis\\data) if your parser interprets escapes.
#
# Recommended precedence model:
#   CLI args > OS environment > .env > config/environments/<profile>.yaml > defaults
#
# Vite/UI safety model:
#   - Only VITE_* variables are exposed to browser code.
#   - Never put secrets in VITE_* variables.
# ==============================================================================


# ------------------------------------------------------------------------------
# 0) QUICKSTART (safe local defaults; copy-to-.env and run)
# ------------------------------------------------------------------------------
# Environment profile selects config/environments/<profile>.yaml
# Known profiles in tree:
#   airgapped, dev, edge, federated, high_availability, home,
#   production, regulated, safety_critical, workstation
FRANCIS_ENV_PROFILE=workstation

# Repo-relative roots (portable across machines)
FRANCIS_CONFIG_DIR=./config
FRANCIS_DATA_DIR=./data

# Logging baseline
FRANCIS_LOG_LEVEL=INFO
FRANCIS_LOG_FORMAT=console
FRANCIS_LOG_DIR=./data/logs

# API service baseline
FRANCIS_API_HOST=127.0.0.1
FRANCIS_API_PORT=8000

# Allow dev UI to call API (comma-separated origins)
FRANCIS_API_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Daemon baseline (runner loop)
FRANCIS_DAEMON_ENABLED=true

# Continuity / ledger baseline
FRANCIS_LEDGER_PATH=./data/conversations/ledger/ledger.jsonl

# Trust baseline (critical subsystem; safe defaults)
FRANCIS_TRUST_INITIAL_LEVEL=0
FRANCIS_TRUST_STATE_PATH=./data/trust/levels/current_state.json
FRANCIS_TRUST_HISTORY_PATH=./data/trust/levels/history.jsonl
FRANCIS_TRUST_DECAY_ENABLED=true
FRANCIS_TRUST_GROWTH_ENABLED=true

# Local LLM baseline (Ollama)
FRANCIS_LLM_PROVIDER=ollama
FRANCIS_OLLAMA_BASE_URL=http://127.0.0.1:11434
FRANCIS_LLM_CHAT_MODEL=francis-chat
FRANCIS_LLM_EMBED_MODEL=francis-embed

# Vite-exposed UI config (browser-visible)
VITE_FRANCIS_API_BASE_URL=http://127.0.0.1:8000
VITE_FRANCIS_WS_URL=ws://127.0.0.1:8000/ws
VITE_FRANCIS_ENV_PROFILE=workstation


# ------------------------------------------------------------------------------
# 1) PROFILE-SPECIFIC OVERRIDES (examples)
# ------------------------------------------------------------------------------
# Development (dev):
#   FRANCIS_ENV_PROFILE=dev
#   FRANCIS_DEBUG=true
#   FRANCIS_LOG_LEVEL=DEBUG
#   FRANCIS_API_CORS_ORIGINS=http://localhost:5173
#
# Production (production):
#   FRANCIS_ENV_PROFILE=production
#   FRANCIS_DEBUG=false
#   FRANCIS_LOG_LEVEL=WARNING
#   FRANCIS_API_AUTH_MODE=jwt
#   FRANCIS_DAEMON_FAIL_FAST=true
#   FRANCIS_API_TRUST_PROXY_HEADERS=true


# ------------------------------------------------------------------------------
# 2) EXECUTION / IDENTITY (optional)
# ------------------------------------------------------------------------------
# Human-friendly instance naming (helpful in logs, multi-instance setups)
# FRANCIS_NAME=Francis
# Stable instance identifier (useful for multi-node / federation)
# FRANCIS_INSTANCE_ID=workstation-01
# Runtime mode hint (do not confuse with FRANCIS_ENV_PROFILE)
# Allowed: dev, test, prod
# FRANCIS_RUN_MODE=dev
# Strict config behavior (fail fast if required config missing/malformed)
# FRANCIS_STRICT_CONFIG=true
# Debug switch (increases verbosity; may relax safeguards if implemented that way)
# FRANCIS_DEBUG=false


# ------------------------------------------------------------------------------
# 3) PATHS / STORAGE ROOTS (optional overrides)
# ------------------------------------------------------------------------------
# If you want to move state off-repo, set these to absolute paths.
# Keep repo-relative defaults for portability.
# FRANCIS_DATA_DIR=./data
# FRANCIS_CONFIG_DIR=./config
# FRANCIS_LOG_DIR=./data/logs
# Artifacts (exports, reports, simulations, plugins)
# FRANCIS_ARTIFACTS_DIR=./data/artifacts
# Domains registry/data
# FRANCIS_DOMAINS_DIR=./data/domains
# FRANCIS_DOMAIN_REGISTRY_PATH=./data/domains/_registry.json
# Conversation continuity storage
# FRANCIS_CONVERSATIONS_DIR=./data/conversations
# FRANCIS_THREADS_DIR=./data/conversations/threads
# FRANCIS_SUMMARIES_DIR=./data/conversations/summaries
# FRANCIS_ROLLING_SUMMARY_PATH=./data/conversations/summaries/rolling_summary.md
# Vector storage (embeddings caches, indexes, stores)
# FRANCIS_VECTORS_DIR=./data/vectors
# FRANCIS_EMBEDDINGS_CACHE_DIR=./data/vectors/embeddings_cache
# FRANCIS_VECTOR_INDEXES_DIR=./data/vectors/indexes
# FRANCIS_VECTOR_STORES_DIR=./data/vectors/stores


# ------------------------------------------------------------------------------
# 4) LOGGING / OBSERVABILITY (optional)
# ------------------------------------------------------------------------------
# Allowed: DEBUG, INFO, WARNING, ERROR, CRITICAL
# FRANCIS_LOG_LEVEL=INFO
# Allowed: console, json, jsonl
# FRANCIS_LOG_FORMAT=console
# If writing structured logs to a single file (jsonl recommended)
# FRANCIS_LOG_FILE=./data/logs/operations/francis.jsonl
# Component-specific log roots (exist in tree)
# FRANCIS_LOG_ERRORS_DIR=./data/logs/errors
# FRANCIS_LOG_AUDIT_DIR=./data/logs/audit
# FRANCIS_LOG_DECISIONS_DIR=./data/logs/decisions
# FRANCIS_LOG_OPERATIONS_DIR=./data/logs/operations
# FRANCIS_LOG_WEB_LEARNING_DIR=./data/logs/web_learning
# FRANCIS_LOG_TRUST_CHANGES_DIR=./data/logs/trust_changes
# FRANCIS_LOG_INDUSTRIAL_OPS_DIR=./data/logs/industrial_ops


# ------------------------------------------------------------------------------
# 5) API SERVICE (host/port/cors/timeouts)
# ------------------------------------------------------------------------------
# Bind address and port
# FRANCIS_API_HOST=127.0.0.1
# FRANCIS_API_PORT=8000
# Optional public URL (useful behind reverse proxies)
# FRANCIS_API_PUBLIC_URL=http://127.0.0.1:8000
# Root path (if mounted under a prefix, e.g., /francis/api)
# FRANCIS_API_ROOT_PATH=
# CORS controls (comma-separated origins)
# Example:
#   http://127.0.0.1:5173,http://localhost:5173
# FRANCIS_API_CORS_ORIGINS=
# FRANCIS_API_CORS_ALLOW_CREDENTIALS=false
# Request sizing/timeouts (strings here; parse/validate in settings)
# FRANCIS_API_MAX_BODY_MB=25
# FRANCIS_API_REQUEST_TIMEOUT_S=60
# WebSocket controls
# FRANCIS_API_WS_ENABLED=true
# FRANCIS_API_WS_PATH=/ws


# ------------------------------------------------------------------------------
# 6) API AUTH / SECURITY (placeholders — do not commit secrets)
# ------------------------------------------------------------------------------
# Auth mode:
#   none  -> open local dev
#   token -> static bearer token
#   jwt   -> JWT signing secret / validation
# FRANCIS_API_AUTH_MODE=none
# Static bearer token (token mode)
# FRANCIS_API_BEARER_TOKEN=__REPLACE_ME__
# JWT secret (jwt mode)
# FRANCIS_API_JWT_SECRET=__REPLACE_ME__
# If running behind trusted reverse proxy (for client IP handling)
# FRANCIS_API_TRUST_PROXY_HEADERS=false


# ------------------------------------------------------------------------------
# 7) DAEMON / RUNNER (scheduler, work loop)
# ------------------------------------------------------------------------------
# Master enable switch
# FRANCIS_DAEMON_ENABLED=true
# Tick interval (ms) — cadence for background loop
# FRANCIS_DAEMON_TICK_MS=250
# Concurrency limits (if runner supports parallel work)
# FRANCIS_DAEMON_MAX_CONCURRENCY=4
# Health/heartbeat interval (seconds)
# FRANCIS_DAEMON_HEARTBEAT_S=15
# Fail-fast mode (crash on first critical error)
# FRANCIS_DAEMON_FAIL_FAST=false


# ------------------------------------------------------------------------------
# 8) PYTHON RUNTIME CONTROLS (optional)
# ------------------------------------------------------------------------------
# Only relevant if your runtime implements these knobs.
# Workers/processes for server/daemon
# FRANCIS_PYTHON_WORKERS=4
# Thread pool size for blocking work offload (I/O bound tasks)
# FRANCIS_PYTHON_THREAD_POOL_SIZE=8


# ------------------------------------------------------------------------------
# 9) CONTINUITY (ledger, threads, summaries)
# ------------------------------------------------------------------------------
# Canonical ledger location (exists in tree)
# FRANCIS_LEDGER_PATH=./data/conversations/ledger/ledger.jsonl
# Optional: rotate ledger or cap growth (implementation-dependent)
# FRANCIS_LEDGER_MAX_MB=250
# FRANCIS_LEDGER_ROTATE=true


# ------------------------------------------------------------------------------
# 10) GOVERNANCE / APPROVALS (policy-driven gating)
# ------------------------------------------------------------------------------
# Approvals directories exist in tree:
#   data/approvals/{pending,approved,rejected,emergency}
# FRANCIS_APPROVALS_DIR=./data/approvals
# Approvals mode (implementation-dependent):
#   disabled -> no gating
#   policy   -> evaluate policy & require approval where needed
#   strict   -> require approval broadly
# FRANCIS_APPROVALS_MODE=policy


# ------------------------------------------------------------------------------
# 11) TRUST SYSTEM (critical: trust levels, decay/growth, metrics)
# ------------------------------------------------------------------------------
# Baseline trust level (int; e.g., 0..100 depending on your design)
# FRANCIS_TRUST_INITIAL_LEVEL=0
# Trust state + history (exist in tree)
# FRANCIS_TRUST_STATE_PATH=./data/trust/levels/current_state.json
# FRANCIS_TRUST_HISTORY_PATH=./data/trust/levels/history.jsonl
# Optional: per-domain trust directory (exists in tree)
# FRANCIS_TRUST_PER_DOMAIN_DIR=./data/trust/levels/per_domain
# Trust mechanism toggles
# FRANCIS_TRUST_DECAY_ENABLED=true
# FRANCIS_TRUST_GROWTH_ENABLED=true
# Trust metrics roots (exist in tree)
# FRANCIS_TRUST_METRICS_DIR=./data/trust/metrics
# Trust certifications (exist in tree)
# FRANCIS_TRUST_CERTIFICATIONS_DIR=./data/trust/certifications
# Trust change log directory (exists in tree)
# FRANCIS_LOG_TRUST_CHANGES_DIR=./data/logs/trust_changes


# ------------------------------------------------------------------------------
# 12) CREDENTIALS VAULT (no secrets in repo)
# ------------------------------------------------------------------------------
# Vault DB path exists in tree
# FRANCIS_VAULT_PATH=./data/credentials/vault.db
# Vault master key / passphrase (required if vault encryption is enabled)
# FRANCIS_VAULT_MASTER_KEY=__REPLACE_ME__
# Optional hardening (KDF controls; implementation-dependent)
# FRANCIS_VAULT_KDF_ITERATIONS=390000


# ------------------------------------------------------------------------------
# 13) LLM RUNTIMES (Ollama-first; multi-model specialization)
# ------------------------------------------------------------------------------
# Provider router (implementation-dependent)
# Suggested values in this tree:
#   ollama
#   ollama_openai_compat
# FRANCIS_LLM_PROVIDER=ollama
# Ollama base URL (default local)
# FRANCIS_OLLAMA_BASE_URL=http://127.0.0.1:11434
# If using the OpenAI-compatible shim/provider, you may need /v1
# FRANCIS_OLLAMA_OPENAI_COMPAT_BASE_URL=http://127.0.0.1:11434/v1
# Model specializations (Modelfiles exist in runtimes/ollama/Modelfiles)
# FRANCIS_LLM_CHAT_MODEL=francis-chat
# FRANCIS_LLM_CODER_MODEL=francis-coder
# FRANCIS_LLM_DELIBERATE_MODEL=francis-deliberate
# FRANCIS_LLM_REFLEX_MODEL=francis-reflex
# FRANCIS_LLM_EMBED_MODEL=francis-embed
# Sampling/runtime controls (strings here; parse/validate in settings)
# FRANCIS_LLM_TEMPERATURE=0.2
# FRANCIS_LLM_MAX_TOKENS=2048
# FRANCIS_LLM_REQUEST_TIMEOUT_S=60
# Optional LLM response caching (if supported)
# FRANCIS_LLM_CACHE_ENABLED=true
# FRANCIS_LLM_CACHE_DIR=./data/vectors/embeddings_cache


# ------------------------------------------------------------------------------
# 14) MEMORY / VECTOR STORES (local-first; optional external backends)
# ------------------------------------------------------------------------------
# Vector store backend selection (implementation-dependent):
#   faiss   -> local disk index
#   qdrant  -> external service
#   pgvector-> postgres extension
# FRANCIS_VECTORSTORE=faiss
# Local vector store roots (exist in tree)
# FRANCIS_VECTORS_DIR=./data/vectors
# FRANCIS_VECTOR_INDEXES_DIR=./data/vectors/indexes
# FRANCIS_VECTOR_STORES_DIR=./data/vectors/stores
# Qdrant (if selected)
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=__REPLACE_ME__
# PGVector (if selected)
# PGVECTOR_DSN=postgresql://user:pass@127.0.0.1:5432/francis
# PGVECTOR_SCHEMA=public


# ------------------------------------------------------------------------------
# 15) EXTERNAL SERVICES (optional; aligns with infra/docker and connectors)
# ------------------------------------------------------------------------------
# PostgreSQL (metadata/state storage, optional)
# POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:5432/francis
# POSTGRES_POOL_SIZE=10
# POSTGRES_POOL_TIMEOUT_S=30
# Redis (queues/cache/pubsub, optional)
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_POOL_SIZE=10
# REDIS_PASSWORD=


# ------------------------------------------------------------------------------
# 16) SYSTEM INTELLIGENCE / PROFILING (probe, baselines, drift)
# ------------------------------------------------------------------------------
# Toggle system profiling/probing
# FRANCIS_SYSTEM_PROFILING_ENABLED=true
# Data roots exist in tree:
#   data/system/{profiles,baselines,drift,inventories,topologies}
# FRANCIS_SYSTEM_DIR=./data/system
# FRANCIS_SYSTEM_PROFILES_DIR=./data/system/profiles
# FRANCIS_SYSTEM_BASELINES_DIR=./data/system/baselines
# FRANCIS_SYSTEM_DRIFT_DIR=./data/system/drift
# FRANCIS_SYSTEM_INVENTORIES_DIR=./data/system/inventories
# FRANCIS_SYSTEM_TOPOLOGIES_DIR=./data/system/topologies
# Optional: where a computed baseline snapshot is written (file name is up to your implementation)
# FRANCIS_SYSTEM_BASELINE_PATH=./data/system/baselines/baseline.json


# ------------------------------------------------------------------------------
# 17) FEDERATION (multi-instance coordination; optional)
# ------------------------------------------------------------------------------
# Toggle federation features
# FRANCIS_FEDERATION_ENABLED=false
# Data roots exist in tree:
#   data/federation/{instances,delegations,consensus_logs,shared_knowledge}
# FRANCIS_FEDERATION_DIR=./data/federation
# Stable ID for this node within a federation
# FRANCIS_FEDERATION_INSTANCE_ID=
# Discovery/coordination endpoint (implementation-dependent)
# FRANCIS_FEDERATION_DISCOVERY_URL=
# Optional sub-paths (exist in tree)
# FRANCIS_FEDERATION_INSTANCES_DIR=./data/federation/instances
# FRANCIS_FEDERATION_DELEGATIONS_DIR=./data/federation/delegations
# FRANCIS_FEDERATION_CONSENSUS_LOGS_DIR=./data/federation/consensus_logs
# FRANCIS_FEDERATION_SHARED_KNOWLEDGE_DIR=./data/federation/shared_knowledge


# ------------------------------------------------------------------------------
# 18) INDUSTRIAL / SIMULATION (digital twins, simulations, safety validations)
# ------------------------------------------------------------------------------
# Toggle industrial/simulation subsystem
# FRANCIS_INDUSTRIAL_ENABLED=false
# Data roots exist in tree:
#   data/industrial/{digital_twins,processes,simulations,safety_validations}
# FRANCIS_INDUSTRIAL_DIR=./data/industrial
# FRANCIS_DIGITAL_TWINS_DIR=./data/industrial/digital_twins
# FRANCIS_INDUSTRIAL_PROCESSES_DIR=./data/industrial/processes
# FRANCIS_SIMULATIONS_DIR=./data/industrial/simulations
# FRANCIS_INDUSTRIAL_SAFETY_VALIDATIONS_DIR=./data/industrial/safety_validations
# Industrial ops logging directory exists in tree
# FRANCIS_LOG_INDUSTRIAL_OPS_DIR=./data/logs/industrial_ops


# ------------------------------------------------------------------------------
# 19) WEB LEARNING / EXTERNAL I/O (gated by policy/approvals)
# ------------------------------------------------------------------------------
# Feature toggle
# FRANCIS_WEB_LEARNING_ENABLED=false
# Require explicit approval for outbound web access (recommended)
# FRANCIS_WEB_LEARNING_REQUIRE_APPROVAL=true
# Logging directory exists in tree
# FRANCIS_WEB_LEARNING_LOG_DIR=./data/logs/web_learning


# ------------------------------------------------------------------------------
# 20) PLUGINS (local plugin system roots)
# ------------------------------------------------------------------------------
# Plugin roots exist in tree:
#   plugins/builtins, plugins/generated, plugins/packs, plugins/registry, plugins/spec
# FRANCIS_PLUGINS_DIR=./plugins
# Where plugin artifacts/outputs are stored (exists in tree)
# FRANCIS_PLUGIN_ARTIFACTS_DIR=./data/artifacts/plugins


# ------------------------------------------------------------------------------
# 21) CHAT UI (Vite) — browser-exposed variables MUST be prefixed with VITE_
# ------------------------------------------------------------------------------
# IMPORTANT: Vite loads .env files from the UI project root (apps/chat_ui).
# If you run the UI from apps/chat_ui, the repo root ".env" may NOT be loaded.
# To ensure the UI sees these values, either:
#   1) Copy the VITE_* variables into apps/chat_ui/.env, OR
#   2) Configure Vite to load env from repo root in vite.config.ts
#
# These variables are exposed to client-side code by Vite.
# Keep them non-sensitive.
#
# API base URL used by UI fetch calls
# VITE_FRANCIS_API_BASE_URL=http://127.0.0.1:8000
# WebSocket URL for realtime events
# VITE_FRANCIS_WS_URL=ws://127.0.0.1:8000/ws
# UI presentation hints
# VITE_FRANCIS_UI_TITLE=Francis
# VITE_FRANCIS_ENV_PROFILE=workstation
